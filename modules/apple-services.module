#!name = Apple — Core Services
#!desc = Catch-all policy for Apple and iCloud traffic. Add the smaller Apple modules above this one when account, push, update, or Intelligence traffic needs a different path.
#!category = Apple

[Proxy Group]
🍎 Apple Services = select,DIRECT,PROXY,🇭🇰 Hong Kong Node,🇸🇬 Singapore Node,🇯🇵 Japan Node,🇹🇼 Taiwan Node,🇺🇸 US Node,interval=86400,timeout=3,select=0,url=http://1.1.1.1/generate_204

[Rule]
# Broad fallback. Put narrower Apple modules above this module.
RULE-SET,https://raw.githubusercontent.com/Repcz/Tool/b3c22feb3add856128c4a7f5353c06bb6ee8e31f/Shadowrocket/Rules/AppleCN.list,🍎 Apple Services
RULE-SET,https://raw.githubusercontent.com/Repcz/Tool/b3c22feb3add856128c4a7f5353c06bb6ee8e31f/Shadowrocket/Rules/AppleServers.list,🍎 Apple Services
