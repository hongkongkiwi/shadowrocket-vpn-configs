#!name = Travel — Back to China (Targeted)
#!desc = Overseas only. Routes selected mainland apps through a mainland exit. Choose one fixed node for account and payment sessions.
#!category = Travel

[Proxy Group]
🇨🇳 CN Auto = url-test,url=http://1.1.1.1/generate_204,interval=300,tolerance=50,timeout=3,select=0,policy-regex-filter=(?i)回国|🇨🇳|中国|回国节点|(\b(CN|China)\b)
🇨🇳 Return to China = select,🇨🇳 CN Auto,PROXY,DIRECT,use=true,interval=86400,timeout=3,select=0,url=http://1.1.1.1/generate_204,policy-regex-filter=(?i)回国|🇨🇳|中国|回国节点|(\b(CN|China)\b)

[Rule]
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/WeChat/WeChat.list,🇨🇳 Return to China
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/AliPay/AliPay.list,🇨🇳 Return to China
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/BiliBili/BiliBili.list,🇨🇳 Return to China
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/NetEaseMusic/NetEaseMusic.list,🇨🇳 Return to China
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/ChinaMedia/ChinaMedia.list,🇨🇳 Return to China
