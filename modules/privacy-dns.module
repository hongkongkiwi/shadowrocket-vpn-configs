#!name = Andy Privacy — Encrypted DNS
#!desc = Uses Cloudflare with Quad9 fallback over HTTPS and intercepts port 53. Intended for Hong Kong and travel outside mainland China.
#!category = Privacy

[General]
dns-server = https://cloudflare-dns.com/dns-query
fallback-dns-server = https://dns.quad9.net/dns-query
dns-direct-system = false
dns-direct-fallback-proxy = false
hijack-dns = *:53
