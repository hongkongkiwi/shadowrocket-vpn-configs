#!name = Andy Downloads — Games and Software
#!desc = Routes selected game, developer, CDN, and Windows Update download hosts. The selector defaults to PROXY; Apple downloads stay in the Apple modules.
#!category = Downloads

[Proxy Group]
⬇️ Bulk Downloads = select,PROXY,DIRECT,🇭🇰 Hong Kong Node,🇺🇸 US Node,🇸🇬 Singapore Node,🇯🇵 Japan Node,🇹🇼 Taiwan Node,interval=86400,timeout=3,select=0,url=http://1.1.1.1/generate_204

[Rule]
# Reviewed against Sukka game-download and download snapshots on 2026-09-10:
# https://ruleset.skk.moe/List/domainset/game-download.conf
# https://ruleset.skk.moe/List/domainset/download.conf
# Game content is kept separate from Steam community/API traffic by matching content hosts only.
