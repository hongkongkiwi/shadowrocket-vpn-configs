#!name = Andy Apple — Intelligence Cloud
#!desc = Routes Apple Intelligence Extensions and Private Cloud Compute through one supported-region exit. Siri and Search have their own module.
#!category = Apple

[Proxy Group]
🧠 Apple PCC = select,🇺🇸 US Node,PROXY,🇭🇰 Hong Kong Node,🇸🇬 Singapore Node,🇯🇵 Japan Node,🇹🇼 Taiwan Node,DIRECT,interval=86400,timeout=3,select=0,url=http://1.1.1.1/generate_204

[Rule]
DOMAIN,apple-relay.apple.com,🧠 Apple PCC
DOMAIN,apple-relay.cloudflare.com,🧠 Apple PCC
DOMAIN,apple-relay.fastly-edge.com,🧠 Apple PCC
DOMAIN,cp4.cloudflare.com,🧠 Apple PCC
