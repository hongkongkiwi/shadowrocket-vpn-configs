#!name = Apple — Push Notifications
#!desc = Gives APNs its own route. DIRECT is the safest default; select a stable proxy only when the local network blocks push traffic.
#!category = Apple

[Proxy Group]
🔔 Apple Push = select,DIRECT,PROXY,🇭🇰 Hong Kong Node,🇸🇬 Singapore Node,🇯🇵 Japan Node,🇹🇼 Taiwan Node,🇺🇸 US Node,interval=86400,timeout=3,select=0,url=http://1.1.1.1/generate_204

[Rule]
DOMAIN-SUFFIX,push.apple.com,🔔 Apple Push
DOMAIN-SUFFIX,push-apple.com.akadns.net,🔔 Apple Push
