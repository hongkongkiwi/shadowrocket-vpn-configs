#!name = Adblock — Lite
#!desc = Conservative adblock (~38k domains). Use instead of Core on older devices, or if Core/Aggressive breaks something. Off = full config rules only.
#!category = Adblock

[Rule]
DOMAIN,token.safebrowsing.apple,DIRECT
DOMAIN,safebrowsing.googleapis.com,DIRECT
DOMAIN,safebrowsing.googleapis-cn.com,DIRECT
DOMAIN,safebrowsing.urlsec.qq.com,DIRECT
# blackmatrix7 AdvertisingLite — smaller curated subset of Advertising
DOMAIN-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/AdvertisingLite/AdvertisingLite_Domain.list,REJECT
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/AdvertisingLite/AdvertisingLite.list,REJECT
