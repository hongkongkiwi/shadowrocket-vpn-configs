#!name = Andy Privacy — Block HTTPDNS
#!desc = Blocks apps' built-in HTTPDNS (Weibo/WeChat/Baidu/NetEase/JD etc.) that bypasses system DNS and your hijack-dns setting. Complements hijack-dns = *:53 (port 53) by catching HTTPDNS over port 443.
#!category = Privacy

[Rule]
# blackmatrix7 BlockHttpDNS — 63 entries: known HTTPDNS endpoints + hardcoded resolver IPs
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/4112f8e7b3a9f23c9ccf381beaa5931a36df3781/rule/Shadowrocket/BlockHttpDNS/BlockHttpDNS.list,REJECT
